# Copy to .env.local. All optional: without Auth0 settings the app runs in dev mode.
# Auth0 → Applications → your Single Page Application.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Must match AUTH0_AUDIENCE in server/.env (the API Identifier).
VITE_AUTH0_AUDIENCE=
# The seeded demo patient.
VITE_PATIENT_ID=00000000-0000-4000-8000-000000000001
