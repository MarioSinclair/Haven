{
  "name": "rehab-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/db-setup.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "export-demo": "node --env-file-if-exists=.env --import tsx scripts/export-demo.ts",
    "voice-pack": "node --env-file-if-exists=.env --import tsx scripts/voice-pack.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
