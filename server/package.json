    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/db-setup.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
