# Copy to .env. Everything except DATABASE_URL is optional; missing pieces switch that feature off.

# Tiger Cloud service connection string (Tiger console → service → Connect).
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Auth0 (leave blank to run locally in dev mode, where every request acts as the demo clinician;
# the server refuses to start without it in production).
# AUTH0_AUDIENCE is the Identifier of the API you create in Auth0 → Applications → APIs.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Comma-separated emails that sign in as clinicians. A patient signs in to the record with their
# email; anyone else sees the demo patient, read-only.
CLINICIAN_EMAILS=

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DEMO_PATIENT_ID=00000000-0000-4000-8000-000000000001
PORT=8787
